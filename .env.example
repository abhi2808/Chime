# Copy to .env in this folder (the repo root) and fill in. Never commit .env.

# --- Spotify -------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard and copy the Client ID.
# This app uses Authorization Code with PKCE, so there is no client secret.
SPOTIFY_CLIENT_ID=

# Must match a redirect URI registered on the Spotify app exactly.
# Spotify rejects "localhost": use the literal 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/spotify/callback

# --- WHOOP ---------------------------------------------------------------
# Create an app at https://developer.whoop.com/dashboard. Unlike Spotify, WHOOP is a
# confidential client: the secret is required for both the code exchange and every
# refresh. Enable these scopes on the app, including "offline" — without it WHOOP issues
# no refresh token and the connection dies within the hour:
#   offline read:profile read:recovery read:sleep read:workout read:cycles
#   read:body_measurement
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match a redirect URI registered on the WHOOP app exactly. WHOOP documents https
# and custom schemes only, so a loopback URI may be refused — if the dashboard will not
# accept this one, we need an https tunnel in front of the dev server.
WHOOP_REDIRECT_URI=http://127.0.0.1:5173/auth/whoop/callback

# --- Secrets -------------------------------------------------------------
# Fernet key for encrypting OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Signs the session and OAuth cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Storage -------------------------------------------------------------
# Relative sqlite paths resolve against the repo root, so this lands in ./data/chime.db.
DATABASE_URL=sqlite:///data/chime.db

# --- Access --------------------------------------------------------------
# Comma-separated Spotify account ids (or public user ids) allowed to sign in.
# Empty means the first account to log in becomes the owner and everyone else is refused.
ALLOWED_SPOTIFY_USER_IDS=

# Where the backend sends the browser after a successful login.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- Optional tuning -----------------------------------------------------
# LOG_LEVEL=INFO
# COOKIE_SECURE=false

# Library sync pacing. Spotify's rate limit is a rolling window per app, and the artist
# phase is one request per artist, so it is the part that trips it. Raising the
# concurrency or lowering the interval makes a first sync faster and a 429 more likely.
# ARTIST_FETCH_CONCURRENCY=2
# SPOTIFY_MIN_REQUEST_INTERVAL_MS=160

# A Retry-After longer than this is handed back to the caller instead of slept through.
# RATE_LIMIT_SLEEP_CEILING_SECONDS=10

# How long the artist phase may run before it stops, saves what it has and finishes on
# the next sync. The run is then reported as "partial", not failed.
# ARTIST_PHASE_BUDGET_SECONDS=300

# WHOOP's limit is 100 requests/min and 10,000/day. A refresh spends four, so this is
# politeness rather than necessity.
# WHOOP_MIN_REQUEST_INTERVAL_MS=250

# How long a stored WHOOP day is served before the next read. Day strain climbs through
# the day; recovery and sleep only change once, in the morning.
# BODY_STATE_TTL_SECONDS=600

# How far back a refresh reads. Two days covers yesterday's cycle still being open when
# the app is first opened in the morning.
# WHOOP_LOOKBACK_HOURS=48
