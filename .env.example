# Copy to .env in this folder (the repo root) and fill in. Never commit .env.

# --- Spotify -------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard and copy the Client ID.
# This app uses Authorization Code with PKCE, so there is no client secret.
SPOTIFY_CLIENT_ID=

# Must match a redirect URI registered on the Spotify app exactly.
# Spotify rejects "localhost": use the literal 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/spotify/callback

# --- WHOOP ---------------------------------------------------------------
# Create an app at https://developer.whoop.com/dashboard. Unlike Spotify, WHOOP is a
# confidential client: the secret is required for both the code exchange and every
# refresh. Enable these scopes on the app, including "offline" — without it WHOOP issues
# no refresh token and the connection dies within the hour:
#   offline read:profile read:recovery read:sleep read:workout read:cycles
#   read:body_measurement
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match a redirect URI registered on the WHOOP app exactly. WHOOP's helper text says
# https only, but its dashboard does accept this loopback URI (verified in Phase 2).
WHOOP_REDIRECT_URI=http://127.0.0.1:5173/auth/whoop/callback

# --- MusicBrainz ---------------------------------------------------------
# Where track tags come from (SPEC section 5). Open data, no key, no account: Spotify has
# stopped sending artist "genres", so this is the only tag source the engine has.
#
# MusicBrainz asks that every client identify itself with an application name, version
# and a way to be contacted, and it blocks clients that do not. Put your repo URL or
# email here before tagging a whole library.
MUSICBRAINZ_USER_AGENT=Chime/0.1 ( https://github.com/your-name/chime )

# --- Secrets -------------------------------------------------------------
# Fernet key for encrypting OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Signs the session and OAuth cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Storage -------------------------------------------------------------
# Relative sqlite paths resolve against the repo root, so this lands in ./data/chime.db.
DATABASE_URL=sqlite:///data/chime.db

# --- Access --------------------------------------------------------------
# Comma-separated Spotify account ids (or public user ids) allowed to sign in.
# Empty means the first account to log in becomes the owner and everyone else is refused.
ALLOWED_SPOTIFY_USER_IDS=

# Where the backend sends the browser after a successful login.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- Deployment (docs/DEPLOY.md) -----------------------------------------
# "production" refuses to start unless the allowlist is set, cookies are secure, every URL
# above is https and the dev API is off. Leave it as development on your own machine.
# APP_ENV=development

# Docker only. What Caddy serves: ":80" for plain http, or your domain name, in which case
# it fetches and renews an https certificate by itself.
# SITE_ADDRESS=:80
# Host ports for the web container. HTTP_PORT=5173 reuses the 127.0.0.1:5173 redirect URIs
# already registered with Spotify and WHOOP, for a local trial.
# HTTP_PORT=80
# HTTPS_PORT=443

# Only for `docker compose --profile postgres`. Then point DATABASE_URL at it:
#   DATABASE_URL=postgresql+psycopg://chime:<password>@postgres:5432/chime
# POSTGRES_PASSWORD=

# --- Optional tuning -----------------------------------------------------
# LOG_LEVEL=INFO
# COOKIE_SECURE=false

# Mounts /api/dev/* and the /dev/rank screen: read-only views into the ranking engine,
# used to check it before there is a session or playback to hear it through. Still behind
# the login. Set to false to take them off the API.
# ENABLE_DEV_API=true

# Library sync pacing. Spotify's rate limit is a rolling window per app, and the artist
# phase is one request per artist, so it is the part that trips it. Raising the
# concurrency or lowering the interval makes a first sync faster and a 429 more likely.
# ARTIST_FETCH_CONCURRENCY=2
# SPOTIFY_MIN_REQUEST_INTERVAL_MS=160

# A Retry-After longer than this is handed back to the caller instead of slept through.
# RATE_LIMIT_SLEEP_CEILING_SECONDS=10

# How long the artist phase may run before it stops, saves what it has and finishes on
# the next sync. The run is then reported as "partial", not failed.
# ARTIST_PHASE_BUDGET_SECONDS=300

# WHOOP's limit is 100 requests/min and 10,000/day. A refresh spends four, so this is
# politeness rather than necessity.
# WHOOP_MIN_REQUEST_INTERVAL_MS=250

# How long a stored WHOOP day is served before the next read. Day strain climbs through
# the day; recovery and sleep only change once, in the morning.
# BODY_STATE_TTL_SECONDS=600

# How far back a refresh reads. Two days covers yesterday's cycle still being open when
# the app is first opened in the morning.
# WHOOP_LOOKBACK_HOURS=48

# MusicBrainz asks for one request per second, so tagging a 1,000 track library takes
# about twenty minutes. Going faster earns a 503, not a faster library.
# MUSICBRAINZ_MIN_REQUEST_INTERVAL_MS=1100

# How well a search hit must match before we believe it is the same song (0-100).
# Lower finds more tracks and tags some of them wrongly.
# MUSICBRAINZ_MIN_SCORE=90

# The genre/tag to energy table. Relative paths resolve against the repo root.
# TAG_MAP_PATH=data/tag_map.yaml

# The live loop, while a session is playing. It polls nothing when nothing is live, so an
# idle Chime makes no outbound requests. Turn it off in a second backend process, or two
# pollers will fight over the same session. The tests run with it off.
# ENABLE_SCHEDULER=true

# How often playback is read. Spotify only says what is playing *now*, so this is the
# resolution at which "skipped it" and "listened to it" are told apart — a song shorter
# than one interval can be missed. Finer measures better and costs more requests.
# PLAYBACK_POLL_SECONDS=20

# How often the mix is re-evaluated. It only changes on a trigger (a mood re-check, a
# readiness or day_part change, 3 skips in the last 5, or fewer than 3 songs to go), so
# most ticks do nothing.
# SESSION_POLL_SECONDS=300

# How often WHOOP is re-read during a session, and only for users who have one. WHOOP
# scores a day rather than a moment, so this only has to be often enough that a change
# becomes a trigger while the session is still running.
# WHOOP_POLL_SECONDS=900
